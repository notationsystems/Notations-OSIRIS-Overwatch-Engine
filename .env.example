# ═══════════════════════════════════════════════════════════════════════════
#  Payload Terminal — Environment Template
#  Copy this file to `.env` (or `.env.local`) and fill in values as needed.
#
#  IMPORTANT — read before filling anything in:
#  Public intelligence feeds work WITHOUT third-party API keys. Aviation, maritime,
#  satellites, fires, earthquakes, weather, news, CVEs, etc. all use public
#  keyless feeds (adsb.lol, celestrak.org, NASA FIRMS open CSV, USGS, …).
#
#  Private freight operations and carrier communications are deliberately
#  disabled until their authority, provider, and webhook secrets are set.
# ═══════════════════════════════════════════════════════════════════════════


# ─────────────────────────────────────────────────────────────────────────
#  RECON SCANNER BACKEND  ── the ONLY keys the current code consumes ──
#  Powers the RECON toolkit (quick/ssl/headers/rdns/subdomains/tech/whois/
#  geoloc/vuln scans). Requires running the separate OSIRIS scanner backend.
#  SCANNER_KEY here MUST equal the backend's OSIRIS_KEY. Generate one with:
#      openssl rand -hex 32
#  Leave both empty to simply disable the RECON features (UI returns 503).
# ─────────────────────────────────────────────────────────────────────────
SCANNER_URL=
SCANNER_KEY=


# ─────────────────────────────────────────────────────────────────────────
#  CLOUDFLARE RADAR  ── read by the code; enables two map layers ──
#  Powers the "Internet Outages" and "Attack Origins" layers under
#  NET & EVENT INTEL (https://radar.cloudflare.com/).
#  Free: any Cloudflare account → My Profile → API Tokens → Create Token →
#  Custom token with permission "Account · Radar · Read".
#  Leave empty to disable — /api/cloudflare-radar returns 503 and both layer
#  toggles stay hidden in the UI. The GDELT Events layer is unaffected and
#  needs no key.
# ─────────────────────────────────────────────────────────────────────────
CLOUDFLARE_API_TOKEN=


# ─────────────────────────────────────────────────────────────────────────
#  CHAIN INTEL  ── optional; the RECON "CHAIN INTEL" tab works without these ──
#  Baseline wallet forensics (BTC/ETH/SOL balance, transaction history,
#  counterparties, OFAC SDN screening, risk scoring) is fully keyless via
#  mempool.space, Blockscout and the public Solana RPC.
#
#  These only deepen it; /api/osint/crypto?probe=1 reports which are active:
#    ETHERSCAN_API_KEY  https://etherscan.io/apis  — internal txs, richer ETH
#    HELIUS_API_KEY     https://helius.dev         — parsed Solana transfers.
#                       Without it, SOL transfer amounts and counterparties
#                       stay blank: the public RPC lists signatures only.
# ─────────────────────────────────────────────────────────────────────────
ETHERSCAN_API_KEY=
HELIUS_API_KEY=


# ─────────────────────────────────────────────────────────────────────────
#  OPTIONAL DATA-SOURCE KEYS  (not read by current code — future / upgrades)
# ─────────────────────────────────────────────────────────────────────────

# NASA FIRMS — active wildfire hotspots.
# Free, instant. Enter an email at the page below and the MAP_KEY is emailed
# to you (looks like 'abcdef1234567890abcdef1234567890'). Limit: 5000 req /
# 10 min. The app already uses the keyless FIRMS CSV; a key only matters if
# you switch to the per-area FIRMS API.
#   Get it: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_API_KEY=

# OpenSky Network — aviation (higher rate limits than the keyless feed).
# Free account. Since March 2025 OpenSky uses OAuth2 (username/password auth
# is dropped). Create an account, open the Account page, create a new API
# client, and copy the client_id / client_secret.
#   Get it: https://opensky-network.org/  (Account → API client)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# N2YO — satellite tracking / pass predictions.
# Free. Register, then Profile page → scroll down → "generate API key".
# The key cannot be changed once issued. Limit: 1000 req / hour.
#   Get it: https://www.n2yo.com/login/register/  (then Profile)
N2YO_API_KEY=

# aisstream.io — live maritime AIS vessel positions via WebSocket.
# Free. Register, then create a key on the API Keys page. Used in the
# subscription message to wss://stream.aisstream.io/v0/stream.
#   Get it: https://aisstream.io/  (sign up → API Keys)
AIS_API_KEY=


# ─────────────────────────────────────────────────────────────────────────
#  RUNTIME
# ─────────────────────────────────────────────────────────────────────────
# Host port the web UI is published on (container always listens on 3000).
# Change this if 3000 is already taken on your host.
PAYLOAD_PORT=3000

# Persistent freight operations. The API fails closed while this token is empty.
PAYLOAD_OPERATIONS_TOKEN=
# Set after running `npm run migrate:operations-db` for an existing deployment.
# When present, freight, carrier communication, procurement, commercial, and project-cargo journals use
# one SQLite/WAL database with a global sequence.
PAYLOAD_DATABASE_PATH=
# Optional separate physical-economy corpus SQLite file. When empty, the
# corpus tables use PAYLOAD_DATABASE_PATH. Keep either path on persistent,
# ordinary local storage (not a synchronized OneDrive folder).
PAYLOAD_CORPUS_DATABASE_PATH=
# Disposable, policy-filtered query projection. Keep it outside the canonical
# database so it can be deleted and deterministically rebuilt by the compiler.
PAYLOAD_CORPUS_READ_MODEL_PATH=
# Dedicated administrative bearer token for corpus append and raw replay.
PAYLOAD_CORPUS_INGEST_TOKEN=
# Separate least-privilege authority for compiling/inspecting read models.
PAYLOAD_CORPUS_COMPILER_TOKEN=
# Bounded Context Compiler query authority and projection-worker authority.
PAYLOAD_CORPUS_QUERY_TOKEN=
PAYLOAD_CORPUS_PROJECTOR_TOKEN=
# Append-only candidate-knowledge registry produced by Payload Miner.
PAYLOAD_CORPUS_PATTERN_REGISTRY_PATH=
# Dedicated miner authority; cannot ingest canonical records or compile read models.
PAYLOAD_CORPUS_MINER_TOKEN=

# Optional central PostgreSQL/PostGIS corpus. The capability-specific URLs
# should use distinct LOGIN roles granted only the matching NOLOGIN service
# role. PAYLOAD_CORPUS_POSTGRES_URL is a compact-installation fallback.
PAYLOAD_CORPUS_POSTGRES_URL=
PAYLOAD_CORPUS_QUERY_DATABASE_URL=
PAYLOAD_CORPUS_INGEST_DATABASE_URL=
PAYLOAD_CORPUS_PROJECTOR_DATABASE_URL=
PAYLOAD_CORPUS_COMPILER_DATABASE_URL=
PAYLOAD_CORPUS_TENANT_ID=
# Required for global ingest/checkpoint operations; customer writes remain
# bound to PAYLOAD_CORPUS_TENANT_ID by both the adapter and PostgreSQL RLS.
PAYLOAD_CORPUS_ALLOW_GLOBAL_WRITE=false
PAYLOAD_CORPUS_POSTGRES_SSL=require
# CLI-only privileged URLs. Never inject these into the web service.
PAYLOAD_CORPUS_MIGRATION_DATABASE_URL=
PAYLOAD_CORPUS_REPLAY_DATABASE_URL=
# Compatibility journals used while PAYLOAD_DATABASE_PATH is empty and as the
# source for the one-time migration.
PAYLOAD_OPERATIONS_LOG=
PAYLOAD_PROCUREMENT_LOG=
PAYLOAD_COMMERCIAL_LOG=
PAYLOAD_PROJECT_CARGO_LOG=

# Dedicated machine authority for OTLP/HTTP JSON physical sensor ingestion.
# This must not reuse the human/operator operations token.
PAYLOAD_TELEMETRY_TOKEN=

# Provider-neutral project execution adapters. Each connector is fail-closed
# until its HTTPS endpoint and bearer credential are both configured.
PAYLOAD_PROJECT_CARRIER_URL=
PAYLOAD_PROJECT_CARRIER_TOKEN=
PAYLOAD_PROJECT_CARRIER_PROVIDER=
PAYLOAD_PROJECT_EDI_URL=
PAYLOAD_PROJECT_EDI_TOKEN=
PAYLOAD_PROJECT_EDI_PROVIDER=
PAYLOAD_PROJECT_ACCOUNTING_URL=
PAYLOAD_PROJECT_ACCOUNTING_TOKEN=
PAYLOAD_PROJECT_ACCOUNTING_PROVIDER=
PAYLOAD_PROJECT_PAYMENT_URL=
PAYLOAD_PROJECT_PAYMENT_TOKEN=
PAYLOAD_PROJECT_PAYMENT_PROVIDER=
PAYLOAD_PROJECT_ADAPTER_TIMEOUT_MS=10000

# Production SP1 batch worker. The official SP1 SDK requires a Linux worker.
# The committed zk/payload-event-batch/verification-key.json is authoritative.
PAYLOAD_SP1_EXECUTABLE=
PAYLOAD_SP1_PROOF_DIR=
# Optional deployment guard. If set, this must exactly match the committed key.
PAYLOAD_SP1_VERIFICATION_KEY=
PAYLOAD_SP1_PROOF_MODE=core
PAYLOAD_SP1_WORKER_ID=

# Authoritative operating inputs. Both services issue free server-side keys.
# FMCSA supplies USDOT identity, operating authority and out-of-service status.
# EIA supplies the latest weekly U.S. on-highway diesel benchmark.
FMCSA_WEB_KEY=
EIA_API_KEY=
PAYLOAD_FREIGHT_SOURCE_TIMEOUT_MS=10000

# Provider-neutral carrier dispatch webhook. Sending fails closed until the
# endpoint and its bearer token are configured. Inbound events use HMAC.
PAYLOAD_CARRIER_DISPATCH_URL=
PAYLOAD_CARRIER_DISPATCH_TOKEN=
PAYLOAD_CARRIER_DISPATCH_PROVIDER=carrier-webhook
PAYLOAD_CARRIER_DISPATCH_TIMEOUT_MS=10000
# At least 32 random bytes; signs inbound raw request bodies.
PAYLOAD_CARRIER_WEBHOOK_SECRET=
PAYLOAD_CARRIER_COMMUNICATIONS_LOG=

# Comma-separated list of public Telegram channel usernames (no @) to scrape
# for the "Telegram OSINT" map layer. Overrides the curated default set.
# Channels must have web preview enabled (most well-known OSINT channels do).
# Default if unset:
#   osintdefender,insiderpaper,aljazeeraenglish,nexta_live,war_monitor
# OSIRIS_TELEGRAM_CHANNELS=

# Set by the Docker image already — override only if needed.
# NODE_ENV=production
# PORT=3000
# HOSTNAME=0.0.0.0
